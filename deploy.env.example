# Copy to deploy.env (gitignored) and fill in. deploy.sh reads it.
#
# This repository is public, so the host, the SSH user and the service name are
# not in it: together with a domain that resolves to the host, a valid username
# is half a credential pair.
PLANETLOGIN_VPS=my-vps               # ssh host or ~/.ssh/config alias
PLANETLOGIN_VPS_USER=deployer        # unix user that owns the deployment
PLANETLOGIN_SERVICE=planetlogin      # docker swarm service to update
PLANETLOGIN_HEALTH_URL=https://auth.example.com/health   # optional, printed at the end
